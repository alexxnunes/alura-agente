# ========================================================
# Configuração de LLM (Preencha uma das opções abaixo)
# ========================================================

# OPÇÃO 1: OpenAI Oficial (Recomendado se você possui créditos/chave OpenAI)
# Crie sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPÇÃO 2: OpenRouter (Suporta modelos gratuitos como Llama 3.3 70B)
# Crie sua chave gratuita em: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/alexxnunes/alura-agente
OPENROUTER_APP_NAME=alura-agente

# ========================================================
# Configuração do RAG e Embeddings
# ========================================================
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
K_RETRIEVAL=4
